# ============================================================
# Generated data -- not tracked (30 of the raw 31G is this)
# ============================================================

# Model weights and tensor caches
*.pt
*.pth
*.npz
*.npy
*.h5
*.nc

# Exception: DINCAE's normalisation stats (17KB, not multi-GB generated data
# like everything else this blanket *.npz rule targets). Needed for inference
# and not stored inside the checkpoint itself -- without it DINCAE's weights
# are unusable even with the code, since state.StateStats reads it separately.
!methods/dincae/artifacts/state_stats.npz

# Exception: the EnKF surrogate's trained weights (14 MB). The filter cannot run without
# them; they used to be a symlink out of the repo. enkf_opt/ links to this same file.
!methods/enkf/enkf_lab/apt-ibex_train_model_28D.pth
!methods/enkf/enkf_opt/apt-ibex_train_model_28D.pth

# DINCAE grid cache (13G)
# **/ instead of a hardcoded path: the 2026-09-03 directory refactor broke
# every hardcoded path, and 1000 seq_ppt frames got staged in once as a
# result. The rule follows the directory name, not a location.
**/cache/

# Per-frame sequence exports (hundreds-thousands of PNGs, cheap to regenerate,
# unused in the paper). Broadened twice, each time because the prefix got narrower
# than the naming actually in use: first from **/check_outputs/eval/seq_ppt_*/ once
# compare/plot_reconstruction_sequence.py started writing under compare/results/
# too, then from **/seq_ppt_*/ once the exports were named after the checkpoint
# (seq_baseline_k16_s123_5000/) instead of after their purpose. Matching on seq_
# alone follows the one thing every such directory has kept.
**/seq_*/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# ============================================================
# Misc
# ============================================================
.DS_Store
core.*

# chain's progress stamp -- transient state
**/.chain_last_epoch

# compare's intermediate artifacts (regression-test scratch output)
compare/results/_*.json

# ============================================================
# supervisor_evaluation: the frozen final weights ARE tracked (126 MB, all
# files < 100 MB); they are what evaluate.py loads and hash-checks.
# Test runs (smoke/verify) under outputs/dev/ are not results -> not tracked.
# ============================================================
!supervisor_evaluation/models/*.pt
!supervisor_evaluation/models/*.npz
supervisor_evaluation/outputs/dev/*
# ...except the route-2 4DVarNet selections, which EVAL_VARIANT=six_allwalk_all92 reads
!supervisor_evaluation/outputs/dev/varnet_wink3_all92_gapmask_20261015/
!supervisor_evaluation/outputs/dev/varnet_augwink3_all92_gapmask_20261015/

# pptxgenjs install used by slides/build_enkf_deck.js
slides/node_modules/
slides/package-lock.json

# thesis figure caches (small; let the figures be redrawn without the data)
!thesis_figures/data/*.npz
supervisor_evaluation/outputs/full_before_reselect/

# ============================================================
# Published results are route 2 (all 92 ATC days, outputs/full_6m_all92/).
# Route-1 (Sunday-only) results and the archive stay on the cluster, not in git.
# ============================================================
supervisor_evaluation/outputs/_archive/
supervisor_evaluation/outputs/logs/
supervisor_evaluation/outputs/full_6m_allwalk/
supervisor_evaluation/outputs/full_5m_allwalk_20261011/
supervisor_evaluation/outputs/full_5m_allwalk_gaussdincae_20261011/
supervisor_evaluation/outputs/reselect_all_walkable_20261010/
supervisor_evaluation/outputs/reselect/
thesis_figures/out_5methods/
