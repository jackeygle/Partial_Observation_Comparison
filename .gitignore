# ============================================================
# 生成数据 —— 不入库（原始 31G 里 30G 都是这些）
# ============================================================

# 模型权重与张量缓存
*.pt
*.pth
*.npz
*.npy
*.h5
*.nc

# DINCAE 网格缓存（13G）
# 用 **/ 而不是写死路径：2026-09-03 的目录重构让写死的路径全部失效，1000 张
# seq_ppt 帧因此被暂存进来一次。规则跟着目录名走，不跟着位置走。
**/cache/

# 逐帧序列图导出（1000 张 PNG，44MB，重跑即得，论文里也用不上）
**/check_outputs/eval/seq_ppt_*/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# ============================================================
# 杂项
# ============================================================
.DS_Store
core.*

# chain 的进展戳，是瞬时状态
**/.chain_last_epoch
